        "text": "نگرانی‌های ایتن دیگر فقط از دست دادن"
      },
      {
        "start": 172.34317757009347,
        "end": 174.77682242990656,
        "text": "حیوان نبود. او منتظر تحویل سفارش‌ها"
      },
      {
        "start": 174.77682242990656,
        "end": 177.28000000000003,
        "text": "بود، مشتریانی که به او وابسته بودند،"
      },
      {
        "start": 177.28,
        "end": 180.56,
        "text": "و هزینه‌هایی که صرفاً به دلیل رفتن اسبش"
      },
      {
        "start": 180.56,
        "end": 183.4194871794872,
        "text": "از بین نمی‌رفتند. خرید یک اسب دیگر"
      },
      {
        "start": 183.4194871794872,
        "end": 186.27897435897438,
        "text": "تقریباً تمام پس‌انداز او را به خطر"
      },
      {
        "start": 186.27897435897438,
        "end": 187.12000000000003,
        "text": "می‌انداخت."
      },
      {
        "start": 187.12,
        "end": 190.50285714285715,
        "text": "برای اولین بار پس از ماه‌ها، مرد جوان"
      },
      {
        "start": 190.50285714285715,
        "end": 194.06857142857143,
        "text": "کاملاً احساس درماندگی کرد. یک شب، پس از"
      },
      {
        "start": 194.06857142857143,
        "end": 196.08,
        "text": "یک جستجوی ناموفق دیگر،"
      },
      {
        "start": 196.08,
        "end": 199.26439024390245,
        "text": "ایتن تنها بیرون خانه‌اش نشسته بود."
      },
      {
        "start": 199.26439024390245,
        "end": 202.4487804878049,
        "text": "آسمان داشت تاریک می‌شد. اصطبل خالی"
      },
      {
        "start": 202.4487804878049,
        "end": 205.7268292682927,
        "text": "روبرویش قرار داشت. به جاده‌ی دوردست"
      },
      {
        "start": 205.7268292682927,
        "end": 207.60000000000002,
        "text": "نگاه کرد و آرام گفت:"
      },
      {
        "start": 207.6,
        "end": 212.87866666666667,
        "text": "کاش اسبم برمی‌گشت. سپس، در لحظه‌ای از"
      },
      {
        "start": 212.87866666666667,
        "end": 216.16,
        "text": "ناامیدی، قول عجیبی داد."
      },
      {
        "start": 216.16,
        "end": 219.59095652173912,
        "text": "اگر اسبم سالم برگردد، آن را در بازار"
      },
      {
        "start": 219.59095652173912,
        "end": 223.3078260869565,
        "text": "فقط به قیمت یک سکه نقره خواهم فروخت. در"
      },
      {
        "start": 223.3078260869565,
        "end": 226.35756521739128,
        "text": "آن لحظه، این قول بی‌اهمیت به نظر"
      },
      {
        "start": 226.35756521739128,
        "end": 227.11999999999998,
        "text": "می‌رسید."
      },
      {
        "start": 227.12,
        "end": 229.8136,
        "text": "گذشته از همه اینها، او همه جا را گشته"
      },
      {
        "start": 229.8136,
        "end": 232.58,
        "text": "بود. تقریباً امیدش را برای دیدن دوباره"
      },
      {
        "start": 232.58,
        "end": 234.4,
        "text": "آن حیوان از دست داده بود."
      },
      {
        "start": 234.4,
        "end": 236.78615384615384,
        "text": "او صرفاً اگر می‌دانست که زنده است"
      },
      {
        "start": 236.78615384615384,
        "end": 239.53384615384613,
        "text": "خوشحال می‌شد. اما زندگی روش عجیبی برای"
      },
      {
        "start": 239.53384615384613,
        "end": 241.91999999999996,
        "text": "آزمایش وعده‌هایی که می‌دهیم دارد."
      },
      {
        "start": 241.92,
        "end": 246.16695652173914,
        "text": "سه روز بعد، صبح زود، ایتن صدای آشنایی"
      },
      {
        "start": 246.16695652173914,
        "end": 249.84,
        "text": "از بیرون شنید. او در را باز کرد."
      },
      {
        "start": 249.84,
        "end": 253.02,
        "text": "و آنجا، نزدیک دروازه چوبی، اسب گمشده‌اش"
      },
      {
        "start": 253.02,
        "end": 256.2,
        "text": "ایستاده بود. پاهایش پوشیده از گل و لای،"
      },
      {
        "start": 256.2,
        "end": 258.32,
        "text": "یال‌هایش در هم پیچیده بود،"
      },
      {
        "start": 258.4,
        "end": 261.3432967032967,
        "text": "و از گشت و گذار خسته به نظر می‌رسید."
      },
      {
        "start": 261.3432967032967,
        "end": 264.2865934065934,
        "text": "اما زنده بود. ایتن به سختی می‌توانست"
      },
      {
        "start": 264.2865934065934,
        "end": 265.84,
        "text": "چشمانش را باور کند."
      },
      {
        "start": 265.84,
        "end": 270.2004819277108,
        "text": "او به سمت اسب دوید، دستانش را دور گردنش"
      },
      {
        "start": 270.2004819277108,
        "end": 274.33734939759034,
        "text": "انداخت و با آسودگی خندید. دوست من، تو"
      },
      {
        "start": 274.33734939759034,
        "end": 275.12,
        "text": "برگشتی."
      },
      {
        "start": 275.12,
        "end": 278.1211111111111,
        "text": "او برای حیوان آب تازه آورد، پوشش بدنش"
      },
      {
        "start": 278.1211111111111,
        "end": 280.96,
        "text": "را تمیز کرد و غذای زیادی به او داد."
      },
      {
        "start": 280.96,
        "end": 284.0253333333333,
        "text": "برای مدتی، ایتن تمام نگرانی‌هایی را که"
      },
      {
        "start": 284.0253333333333,
        "end": 287.01,
        "text": "در آن روزهای سخت با خود حمل کرده بود،"
      },
      {
        "start": 287.01,
        "end": 289.67199999999997,
        "text": "فراموش کرد. ارزشمندترین دارایی‌اش"
      },
      {
        "start": 289.67199999999997,
        "end": 290.64,
        "text": "بازگشته بود."
      },
      {
        "start": 290.64,
        "end": 293.8690909090909,
        "text": "اما ناگهان، همانطور که کنار اصطبل"
      },
      {
        "start": 293.8690909090909,
        "end": 297.48958677685954,
        "text": "ایستاده بود، فکری از ذهنش گذشت. قولش."
      },
      {
        "start": 297.48958677685954,
        "end": 301.305785123967,
        "text": "او قول داده بود که اسب را فقط به یک سکه"
      },
      {
        "start": 301.305785123967,
        "end": 302.48,
        "text": "نقره بفروشد."
      },
      {
        "start": 302.48,
        "end": 305.18600000000004,
        "text": "لبخند ایتن به آرامی محو شد. او به"
      },
      {
        "start": 305.18600000000004,
        "end": 308.302,
        "text": "حیوانی که با آرامش روبرویش ایستاده بود"
      },
      {
        "start": 308.302,
        "end": 309.04,
        "text": "نگاه کرد."
      },
      {
        "start": 309.04,
        "end": 312.2508474576271,
        "text": "یک اسب سالم مثل این حداقل صد سکه نقره"
      },
      {
        "start": 312.2508474576271,
        "end": 315.4616949152542,
        "text": "می‌ارزید. فروختن آن به قیمت یک سکه به"
      },
      {
        "start": 315.4616949152542,
        "end": 318.0650847457627,
        "text": "معنای از دست دادن تقریباً تمام"
      },
      {
        "start": 318.0650847457627,
        "end": 319.28,
        "text": "دارایی‌اش بود."
      },
      {
        "start": 319.28,
        "end": 323.1634042553191,
        "text": "او روی یک نیمکت چوبی نشست و شروع به فکر"
      },
      {
        "start": 323.1634042553191,
        "end": 327.04680851063824,
        "text": "کردن کرد، چرا چنین قول احمقانه‌ای دادم؟"
      },
      {
        "start": 327.04680851063824,
        "end": 328.63999999999993,
        "text": "سرش را تکان داد."
      },
      {
        "start": 328.64,
        "end": 331.9854545454545,
        "text": "آنقدر نگران از دست دادن اسبم بودم که"
      },
      {
        "start": 331.9854545454545,
        "end": 335.42383838383836,
        "text": "هرگز تصور نمی‌کردم واقعاً برگردد. چند"
      },
      {
        "start": 335.42383838383836,
        "end": 337.84,
        "text": "دقیقه‌ای، به زمین خیره شد."
      },
      {
        "start": 337.84,
        "end": 340.57951219512194,
        "text": "او می‌توانست به راحتی قولش را فراموش"
      },
      {
        "start": 340.57951219512194,
        "end": 343.2429268292683,
        "text": "کند. وقتی این کار را می‌کرد، هیچ‌کس"
      },
      {
        "start": 343.2429268292683,
        "end": 344.08,
        "text": "کنارش نبود."
      },
      {
        "start": 344.08,
        "end": 346.49889763779527,
        "text": "اما ایتن نمی‌خواست وانمود کند که"
      },
      {
        "start": 346.49889763779527,
        "end": 349.29574803149603,
        "text": "حرف‌های خودش هیچ معنایی ندارد. از طرف"
      },
      {
        "start": 349.29574803149603,
        "end": 352.0925984251968,
        "text": "دیگر، از دست دادن چنین حیوان ارزشمندی"
      },
      {
        "start": 352.0925984251968,
        "end": 353.67999999999995,
        "text": "تقریباً بدون هیچ پولی"
      },
      {
        "start": 353.68,
        "end": 356.49600000000004,
        "text": "پذیرفتنش به همان اندازه دشوار به نظر"
      },
      {
        "start": 356.49600000000004,
        "end": 358.9991111111112,
        "text": "می‌رسید. او خود را بین دو انتخاب"
      },
      {
        "start": 358.9991111111112,
        "end": 360.7200000000001,
        "text": "ناخوشایند گرفتار یافت."
      },
      {
        "start": 360.72,
        "end": 363.73764705882354,
        "text": "برای یک مرد معمولی، این وضعیت ممکن بود"
      },
      {
        "start": 363.73764705882354,
        "end": 366.5170588235294,
        "text": "غیرممکن به نظر برسد. اما ایتن آماده"
      },
      {
        "start": 366.5170588235294,
        "end": 369.6141176470588,
        "text": "تسلیم شدن نبود. او به آرامی شروع به قدم"
      },
      {
        "start": 369.6141176470588,
        "end": 371.5199999999999,
        "text": "زدن در حیاط خانه‌اش کرد."
      },
      {
        "start": 371.52,
        "end": 375.09,
        "text": "حتماً راه دیگری هم هست. زمزمه کرد."
      },
      {
        "start": 375.09,
        "end": 378.86999999999995,
        "text": "دوباره به قولش فکر کرد. قول داده بود"
      },
      {
        "start": 378.86999999999995,
        "end": 382.85999999999996,
        "text": "اسب را به یک سکه نقره بفروشد. این واضح"
      },
      {
        "start": 382.85999999999996,
        "end": 383.28,
        "text": "بود."
      },
      {
        "start": 383.28,
        "end": 386.934693877551,
        "text": "اما آیا او قول دیگری هم داده بود؟ نه."
      },
      {
        "start": 386.934693877551,
        "end": 390.6881632653061,
        "text": "از راه رفتن ایستاد. سپس قول را کلمه به"
      },
      {
        "start": 390.6881632653061,
        "end": 392.96,
        "text": "کلمه در ذهنش تکرار کرد."
      },
      {
        "start": 392.96,
        "end": 396.12129032258065,
        "text": "من اسبم را به یک سکه نقره می‌فروشم."
      },
      {
        "start": 396.12129032258065,
        "end": 399.2825806451613,
        "text": "درست همان موقع، یک گربه کوچک از پشت"
      },
      {
        "start": 399.2825806451613,
        "end": 401.36,
        "text": "توده‌ای هیزم بیرون آمد."
      },
      {
        "start": 401.36,
        "end": 404.2031578947368,
        "text": "متعلق به اتان بود و اغلب در حیاط پرسه"
      },
      {
        "start": 404.2031578947368,
        "end": 406.4315789473684,
        "text": "می‌زد و هر جا که دلش می‌خواست"
      },
      {
        "start": 406.4315789473684,
        "end": 407.2,
        "text": "می‌خوابید."
      },
      {
        "start": 407.2,
        "end": 410.92387096774195,
        "text": "گربه با تنبلی کش و قوسی به بدنش داد، از"
      },
      {
        "start": 410.92387096774195,
        "end": 414.6477419354839,
        "text": "کنار پاهایش گذشت و نزدیک اسب نشست. ایتن"
      },
      {
        "start": 414.6477419354839,
        "end": 418.2761290322581,
        "text": "به گربه نگاه کرد، سپس به اسب، و دوباره"
      },
      {
        "start": 418.2761290322581,
        "end": 419.04,
        "text": "به گربه."
      },
      {
        "start": 419.04,
        "end": 422.76761904761906,
        "text": "ناگهان لبخندی بر لبانش نقش بست. البته،"
      },
      {
        "start": 422.76761904761906,
        "end": 426.0047619047619,
        "text": "با تعجب گفت، چرا قبلاً به این فکر"
      },
      {
        "start": 426.0047619047619,
        "end": 427.28,
        "text": "نیفتاده بودم؟"
      },
      {
        "start": 427.28,
        "end": 430.19666666666666,
        "text": "او با عجله وارد خانه شد و با یک تکه"
      },
      {
        "start": 430.19666666666666,
        "end": 433.44666666666666,
        "text": "طناب کوچک برگشت. او به آرامی افسار گربه"
      },
      {
        "start": 433.44666666666666,
        "end": 435.28,
        "text": "را به زین اسب وصل کرد."
      },
      {
        "start": 435.28,
        "end": 438.358,
        "text": "سپس عقب ایستاد و آرایش غیرمعمول خود را"
      },
      {
        "start": 438.358,
        "end": 441.112,
        "text": "تحسین کرد. اسب کاملاً طبیعی به نظر"
      },
      {
        "start": 441.112,
        "end": 441.76000000000005,
        "text": "می‌رسید."
      },
      {
        "start": 441.76,
        "end": 445.4104,
        "text": "با این حال، گربه از دخالت ناگهانی‌اش در"
      },
      {
        "start": 445.4104,
        "end": 448.9672,
        "text": "این تجارت کمی گیج به نظر می‌رسید. ایتن"
      },
      {
        "start": 448.9672,
        "end": 451.12,
        "text": "خندید، دوست کوچک عزیزم،"
      },
      {
        "start": 451.12,
        "end": 455.2913043478261,
        "text": "فردا قرار است گران‌ترین گربه‌ی کل قلمرو"
      },
      {
        "start": 455.2913043478261,
        "end": 459.14173913043476,
        "text": "باشی. صبح روز بعد، ایتن به شلوغ‌ترین"
      },
      {
        "start": 459.14173913043476,
        "end": 460.96,
        "text": "بازار قلمرو رسید."
      },
      {
        "start": 460.96,
        "end": 463.1321212121212,
        "text": "تاجران سبزیجات را مرتب می‌کردند،"
      },
      {
        "start": 463.1321212121212,
        "end": 465.77939393939397,
        "text": "کشاورزان کیسه‌های غلات را خالی می‌کردند"
      },
      {
        "start": 465.77939393939397,
        "end": 468.3587878787879,
        "text": "و بازرگانان قیمت‌ها را با صدای بلند به"
      },
      {
        "start": 468.3587878787879,
        "end": 469.92,
        "text": "مشتریان رهگذر می‌گفتند."
      },
      {
        "start": 469.92,
        "end": 472.86776470588234,
        "text": "ایتن جایی نزدیک مرکز بازار را انتخاب"
      },
      {
        "start": 472.86776470588234,
        "end": 475.89741176470585,
        "text": "کرد. او کنار اسبش ایستاد و گربه نزدیک"
      },
      {
        "start": 475.89741176470585,
        "end": 476.87999999999994,
        "text": "پاهایش نشست."
      },
      {
        "start": 476.88,
        "end": 480.2526315789474,
        "text": "سپس صدایش را بلند کرد، یک اسب سالم و"
      },
      {
        "start": 480.2526315789474,
        "end": 483.7189473684211,
        "text": "خوب برای فروش. افرادی که در آن نزدیکی"
      },
      {
        "start": 483.7189473684211,
        "end": 487.1852631578948,
        "text": "بودند برگشتند تا نگاه کنند. یکی فریاد"
      },
      {
        "start": 487.1852631578948,
        "end": 490.6515789473685,
        "text": "زد: «چقدر؟» ایتن لبخند زد، فقط یک سکه"
      },
      {
        "start": 490.6515789473685,
        "end": 491.12000000000006,
        "text": "نقره."
      },
      {
        "start": 491.12,
        "end": 494.3254794520548,
        "text": "برای لحظه‌ای، به نظر رسید که بازار ساکت"
      },
      {
        "start": 494.3254794520548,
        "end": 497.12,
        "text": "شد. سپس چند نفر به سمت او شتافتند."
      },
      {
        "start": 497.12,
        "end": 501.21696969696967,
        "text": "یک تاجر مسن پرسید، یک سکه نقره برای این"
      },
      {
        "start": 501.21696969696967,
        "end": 504.9987878787878,
        "text": "اسب؟ ایتن پاسخ داد، دقیقاً یکی. تاجر"
      },
      {
        "start": 504.9987878787878,
        "end": 507.5199999999999,
        "text": "اسب را با دقت بررسی کرد."
      },
      {
        "start": 507.52,
        "end": 510.7986440677966,
        "text": "پاهایش قوی و دندان‌هایش سالم بودند. هیچ"
      },
      {
        "start": 510.7986440677966,
        "end": 513.9091525423729,
        "text": "نشانه‌ای از بیماری در او دیده نمی‌شد."
      },
      {
        "start": 513.9091525423729,
        "end": 517.1037288135594,
        "text": "ارزش حیوان خیلی بیشتر از قیمت درخواستی"
      },
      {
        "start": 517.1037288135594,
        "end": 517.44,
        "text": "بود."
      },
      {
        "start": 517.44,
        "end": 520.6,
        "text": "تاجر اعلام کرد: «من آن را می‌خرم.» دستش"
      },
      {
        "start": 520.6,
        "end": 523.3548717948718,
        "text": "را در کیفش برد و یک سکه نقره بیرون"
      },
      {
        "start": 523.3548717948718,
        "end": 523.76,
        "text": "آورد."
      },
      {
        "start": 523.76,
        "end": 527.3527272727273,
        "text": "اما درست زمانی که می‌خواست آن را تحویل"
      },
      {
        "start": 527.3527272727273,
        "end": 530.8509090909091,
        "text": "دهد، ایتن دستش را بلند کرد. «یه لحظه،"
      },
      {
        "start": 530.8509090909091,
        "end": 534.4436363636364,
        "text": "دوست من، یه شرط کوچیک وجود داره.» تاجر"
      },
      {
        "start": 534.4436363636364,
        "end": 535.2,
        "text": "اخم کرد."
      },
      {
        "start": 535.2,
        "end": 539.4819417475728,
        "text": "چه شرطی؟ ایتن به گربه اشاره کرد. قیمت"
      },
      {
        "start": 539.4819417475728,
        "end": 543.7638834951456,
        "text": "اسب یک سکه نقره است، اما قیمت گربه ۹۹"
      },
      {
        "start": 543.7638834951456,
        "end": 547.12,
        "text": "سکه نقره. تاجر به او خیره شد."
      },
      {
        "start": 547.12,
        "end": 551.2384000000001,
        "text": "۹۹ سکه برای آن گربه؟ بله، ایتن با آرامش"
      },
      {
        "start": 551.2384000000001,
        "end": 555.0400000000001,
        "text": "پاسخ داد. اما من گربه نمی‌خواهم، فقط"
      },
      {
        "start": 555.0400000000001,
        "end": 558.9472000000001,
        "text": "اسب را می‌خواهم. ایتن مودبانه سر تکان"
      },
      {
        "start": 558.9472000000001,
        "end": 560.32,
        "text": "داد. می‌فهمم."
      },
      {
        "start": 560.32,
        "end": 563.0506666666668,
        "text": "متأسفانه اسب و گربه با هم فروخته"
      },
      {
        "start": 563.0506666666668,
        "end": 566.1226666666668,
        "text": "می‌شوند. نمی‌توانم یکی را بدون دیگری"
      },
      {
        "start": 566.1226666666668,
        "end": 566.7200000000001,
        "text": "بفروشم."
      },
      {
        "start": 566.72,
        "end": 569.44,
        "text": "تاجر نگاهش را از اسب به گربه و سپس"
      },
      {
        "start": 569.44,
        "end": 572.5600000000001,
        "text": "دوباره به ایتن دوخت. برای لحظه‌ای زبانش"
      },
      {
        "start": 572.5600000000001,
        "end": 575.52,
        "text": "بند آمد. چند نفر در آن نزدیکی شروع به"
      },
      {
        "start": 575.52,
        "end": 576.56,
        "text": "خندیدن کردند."
      },
      {
        "start": 576.56,
        "end": 579.0646153846153,
        "text": "یکی از مردها فریاد زد، آیا آن گربه از"
      },
      {
        "start": 579.0646153846153,
        "end": 581.433846153846,
        "text": "طلا ساخته شده است؟ دیگری پرسید، آیا"
      },
      {
        "start": 581.433846153846,
        "end": 583.9384615384614,
        "text": "موش‌هایی را که از نقره ساخته شده‌اند،"
      },
      {
        "start": 583.9384615384614,
        "end": 584.4799999999999,
        "text": "می‌گیرد؟"
      },
      {
        "start": 584.48,
        "end": 588.0025806451613,
        "text": "حتی ایتن هم نتوانست لبخندش را پنهان"
      },
      {
        "start": 588.0025806451613,
        "end": 591.8270967741936,
        "text": "کند، اما محکم ایستاد. قیمت اسب یک سکه،"
      },
      {
        "start": 591.8270967741936,
        "end": 595.6516129032259,
        "text": "قیمت گربه ۹۹ سکه. قیمت هر دو با هم ۱۰۰"
      },
      {
        "start": 595.6516129032259,
        "end": 596.96,
        "text": "سکه نقره است."
      },
      {
        "start": 596.96,
        "end": 600.0365354330709,
        "text": "بعضی از مشتریان سرشان را تکان دادند و"
      },
      {
        "start": 600.0365354330709,
        "end": 603.1962204724409,
        "text": "رفتند. بعضی دیگر ماندند و از این ترتیب"
      },
      {
        "start": 603.1962204724409,
        "end": 606.1064566929133,
        "text": "عجیب شگفت‌زده شدند. سرانجام یک تاجر"
      },
      {
        "start": 606.1064566929133,
        "end": 607.5199999999999,
        "text": "دوره‌گرد جلو آمد."
      },
      {
        "start": 607.52,
        "end": 611.3095890410958,
        "text": "او اسب را معاینه کرد و با دقت به حالات"
      },
      {
        "start": 611.3095890410958,
        "end": 614.8,
        "text": "غیرعادی ایتن گوش داد. سپس لبخند زد."
      },
      {
        "start": 614.8,
        "end": 618.6355140186915,
        "text": "پس، برای اسب و گربه با هم ۱۰۰ سکه نقره"
      },
      {
        "start": 618.6355140186915,
        "end": 622.2691588785046,
        "text": "می‌خواهی؟ ایتن پاسخ داد: «درست است.»"
      },
      {
        "start": 622.2691588785046,
        "end": 625.6,
        "text": "تاجر یک بار دیگر به اسب نگاه کرد."
      },
      {
        "start": 625.6,
        "end": 629.2327272727273,
        "text": "اسب قوی هیکلی بود و ۱۰۰ سکه برای اسبی"
      },
      {
        "start": 629.2327272727273,
        "end": 632.08,
        "text": "با آن کیفیت، قیمت معقولی بود."
      },
      {
        "start": 632.08,
        "end": 635.5,
        "text": "گربه اضافه‌ی غیرضروری بود، اما به سختی"
      },
      {
        "start": 635.5,
        "end": 639.01,
        "text": "می‌توانست دلیلی برای رد خرید باشد. تاجر"
      },
      {
        "start": 639.01,
        "end": 640.72,
        "text": "شروع به خندیدن کرد."
      },
      {
        "start": 640.72,
        "end": 643.567619047619,
        "text": "مرد جوان، نمی‌دانم چه چیزی باعث شد چنین"
      },
      {
        "start": 643.567619047619,
        "end": 646.415238095238,
        "text": "معامله‌ی عجیبی را اختراع کنی، اما من به"
      },
      {
        "start": 646.415238095238,
        "end": 648.8977777777777,
        "text": "یک اسب خوب نیاز دارم و اسب تو ارزش"
      },
      {
        "start": 648.8977777777777,
        "end": 649.92,
        "text": "قیمتش را دارد."
      },
      {
        "start": 649.92,
        "end": 653.2259459459459,
        "text": "او ۱۰۰ سکه نقره شمرد. ایتن پول را"
      },
      {
        "start": 653.2259459459459,
        "end": 656.7322522522522,
        "text": "پذیرفت. یک سکه را در جیب جداگانه‌ای"
      },
      {
        "start": 656.7322522522522,
        "end": 660.438918918919,
        "text": "گذاشت. ۹۹ سکه باقی‌مانده را داخل کیفش"
      },
      {
        "start": 660.438918918919,
        "end": 661.0400000000001,
        "text": "گذاشت."
      },
      {
        "start": 661.04,
        "end": 664.1504,
        "text": "تاجر اسب و گربه را گرفت و در حالی که"
      },
      {
        "start": 664.1504,
        "end": 667.4336,
        "text": "هنوز به خرید غیرمعمول لبخند می‌زد، دور"
      },
      {
        "start": 667.4336,
        "end": 670.8032,
        "text": "شد. ایتن تماشایشان کرد که در بازار شلوغ"
      },
      {
        "start": 670.8032,
        "end": 671.8399999999999,
        "text": "ناپدید شدند."
      },
      {
        "start": 671.84,
        "end": 675.9928571428571,
        "text": "اسبش فروخته شد. قیمت اسب دقیقاً یک سکه"
      },
      {
        "start": 675.9928571428571,
        "end": 679.7085714285714,
        "text": "نقره بود و گربه کوچولو ۹۹ سکه دیگر"
      },
      {
        "start": 679.7085714285714,
        "end": 683.4242857142857,
        "text": "برایش آورده بود. وقتی ایتن به خانه"
      },
      {
        "start": 683.4242857142857,
        "end": 684.08,
        "text": "برگشت،"
      },
      {
        "start": 684.08,
        "end": 687.3356521739131,
        "text": "خبر این معامله عجیب از قبل در بازار پخش"
      },
      {
        "start": 687.3356521739131,
        "end": 690.1739130434783,
        "text": "شده بود. برخی آن را هوشمندانه‌ترین"
      },
      {
        "start": 690.1739130434783,
        "end": 693.0121739130434,
        "text": "معامله‌ای که تا به حال دیده بودند،"
      },
      {
        "start": 693.0121739130434,
        "end": 693.68,
        "text": "نامیدند."
      },
      {
        "start": 693.68,
        "end": 696.4256,
        "text": "دیگران گفتند که تا به حال اسم چنین گربه"
      },
      {
        "start": 696.4256,
        "end": 699.0304000000001,
        "text": "گران‌قیمتی را نشنیده‌اند. اما همه روی"
      },
      {
        "start": 699.0304000000001,
        "end": 700.7200000000001,
        "text": "یک چیز اتفاق نظر داشتند."
      },
      {
        "start": 700.72,
        "end": 704.24,
        "text": "آنها مدت‌ها آن تاجر جوان را به یاد"
      },
      {
        "start": 704.24,
        "end": 708.1741176470588,
        "text": "داشتند. آن شب، ایتن پشت میزش نشست و یک"
      },
      {
        "start": 708.1741176470588,
        "end": 711.28,
        "text": "بار دیگر سکه‌های نقره را شمرد."
      },
      {
        "start": 711.28,
        "end": 714.3932075471698,
        "text": "تنها چند روز قبل، او معتقد بود که"
      },
      {
        "start": 714.3932075471698,
        "end": 717.6950943396226,
        "text": "وضعیتش هیچ راه حل خوبی ندارد. حالا،"
      },
      {
        "start": 717.6950943396226,
        "end": 721.28,
        "text": "همان مشکل بسیار متفاوت به نظر می‌رسید."
      },
      {
        "start": 721.28,
        "end": 724.2953846153846,
        "text": "او سکه‌ها را داخل یک جعبه چوبی کوچک"
      },
      {
        "start": 724.2953846153846,
        "end": 727.6553846153846,
        "text": "گذاشت، درب آن را بست و لبخند زد. و جایی"
      },
      {
        "start": 727.6553846153846,
        "end": 729.12,
        "text": "در قلمرو پادشاهی،"
      },
      {
        "start": 729.12,
        "end": 731.535632183908,
        "text": "احتمالاً یک تاجر سیار داشت فکر می‌کرد"
      },
      {
        "start": 731.535632183908,
        "end": 734.0818390804596,
        "text": "با گران‌ترین گربه‌ای که تا به حال خریده"
      },
      {
        "start": 734.0818390804596,
        "end": 734.7999999999998,
        "text": "بود چه کند."
      },
      {
        "start": 734.8,
        "end": 737.5865648854962,
        "text": "چیزی که یاد گرفتم این بود که زندگی گاهی"
      },
      {
        "start": 737.5865648854962,
        "end": 740.2302290076336,
        "text": "ما را در موقعیت‌های سختی قرار می‌دهد."
      },
      {
        "start": 740.2302290076336,
        "end": 742.2308396946565,
        "text": "ما اشتباه می‌کنیم، با ضررهای"
      },
      {
        "start": 742.2308396946565,
        "end": 744.1600000000001,
        "text": "غیرمنتظره‌ای روبرو می‌شویم،"
      },
      {
        "start": 744.16,
        "end": 746.6494915254237,
        "text": "و با مشکلاتی روبرو می‌شویم که به روش"
      },
      {
        "start": 746.6494915254237,
        "end": 749.0698305084746,
        "text": "معمول قابل حل نیستند. اما من معتقدم"
      },
      {
        "start": 749.0698305084746,
        "end": 751.766779661017,
        "text": "وقتی تکرار را متوقف می‌کنیم، اتفاق مهمی"
      },
      {
        "start": 751.766779661017,
        "end": 752.32,
        "text": "می‌افتد،"
      },
      {
        "start": 752.32,
        "end": 754.8275862068966,
        "text": "این غیرممکن است، و از خود بپرسید، چه"
      },
      {
        "start": 754.8275862068966,
        "end": 757.4744827586208,
        "text": "چیزی را هنوز در نظر نگرفته‌ام؟ یک سوال"
      },
      {
        "start": 757.4744827586208,
        "end": 760.1213793103449,
        "text": "متفاوت می‌تواند امکان متفاوتی را ایجاد"
      },
      {
        "start": 760.1213793103449,
        "end": 760.4000000000001,
        "text": "کند."
      },
      {
        "start": 760.4,
        "end": 762.9812949640287,
        "text": "بنابراین دفعه‌ی بعد که با یک مشکل دشوار"
      },
      {
        "start": 762.9812949640287,
        "end": 765.4964028776978,
        "text": "روبرو شدید، تسلیم اولین نتیجه‌گیری خود"
      },
      {
        "start": 765.4964028776978,
        "end": 767.8129496402878,
        "text": "نشوید. آرام باشید، دوباره فکر کنید،"
      },
      {
        "start": 767.8129496402878,
        "end": 769.6,
        "text": "فراتر از بدیهیات را ببینید،"
      },
      {
        "start": 769.6,
        "end": 771.7692307692308,
        "text": "و به دنبال راه حلی باشید که هم"
      },
      {
        "start": 771.7692307692308,
        "end": 774.3000000000001,
        "text": "هوشمندانه و هم درست باشد. زیرا گاهی"
      },
      {
        "start": 774.3000000000001,
        "end": 777.1200000000001,
        "text": "اوقات، پاسخ در تغییر موقعیت پنهان نیست."
      },
      {
        "start": 777.12,
        "end": 779.734647887324,
        "text": "در تغییر نحوه نگاه شما به آن پنهان است."
      },
      {
        "start": 779.734647887324,
        "end": 782.1481690140845,
        "text": "به یاد داشته باشید، هر مشکلی راه حلی"
      },
      {
        "start": 782.1481690140845,
        "end": 784.6287323943661,
        "text": "دارد. و گاهی اوقات، تنها چیزی که نیاز"
      },
      {
        "start": 784.6287323943661,
        "end": 786.6399999999999,
        "text": "دارید، یک روش تفکر متفاوت است."
      }
    ],
    "duration": 786.853991
  },
  "stats": {
    "success": 0,
    "failed": 5
  }
}